{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "customer-zero": {
      "development": {
        "port": 3000
      }
    },
    "business-intelligence": {
      "routing": [
        { "path": "/bi" },
        { "path": "/bi/:path*" },
        { "path": "/analytics" },
        { "path": "/analytics/:path*" },
        { "path": "/finance" },
        { "path": "/finance/:path*" }
      ],
      "development": {
        "port": 3001
      }
    },
    "admin-console": {
      "routing": [
        { "path": "/admin" },
        { "path": "/admin/:path*" },
        { "path": "/platform" },
        { "path": "/platform/:path*" }
      ],
      "development": {
        "port": 3002
      }
    }
  }
}
