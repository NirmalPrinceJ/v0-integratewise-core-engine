        "nps_score",
        "csat_score"
      ],
      "default_filters": {
        "entity_type": "organization",
        "tenant_id": "{{tenant_id}}"
      },
      "confidence_threshold": 0.65
    },
    {
      "memory_table": "memory_notes",
      "required_columns": [
        "id",
        "tenant_id",
        "entity_type",
        "entity_id",
        "note_text",
        "recorded_at"
      ],
      "optional_columns": [
        "note_type",
        "author_id",
        "is_private",
        "tags",
        "related_entity_type",
        "related_entity_id"
      ],
      "default_filters": {
        "entity_type": "organization",
        "is_private": false,
        "tenant_id": "{{tenant_id}}"
      },
      "confidence_threshold": 0.5
    }
  ],
